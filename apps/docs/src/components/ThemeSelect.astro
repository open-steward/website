---
// Starlight's ThemeSelect and Select (@astrojs/starlight 0.42.10, MIT licence) in one component,
// without the inline script and the inline width style: the module script below updates the
// picker, and the width is in the stylesheet.
// Copyright (c) 2023 Astro contributors; the MIT notice is in THIRD-PARTY-NOTICES.md.
import { Icon } from '@astrojs/starlight/components'

const options = [
  { label: Astro.locals.t('themeSelect.dark'), value: 'dark' },
  { label: Astro.locals.t('themeSelect.light'), value: 'light' },
  { label: Astro.locals.t('themeSelect.auto'), value: 'auto' },
]
---

<starlight-theme-select>
  <label>
    <span class="sr-only">{Astro.locals.t('themeSelect.accessibleLabel')}</span>
    <Icon name="laptop" class="icon label-icon" />
    <select autocomplete="off">
      {options.map(({ value, label }) => <option value={value} selected={value === 'auto'}>{label}</option>)}
    </select>
    <Icon name="down-caret" class="icon caret" />
  </label>
</starlight-theme-select>

<script>
  type Theme = 'auto' | 'dark' | 'light'
  const storageKey = 'starlight-theme'
  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto'
  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey))
  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '')
    }
  }
  const getPreferredColorScheme = (): Theme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'

  function onThemeChange(theme: Theme): void {
    StarlightThemeProvider.updatePickers(theme)
    document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme
    storeTheme(theme)
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') onThemeChange('auto')
  })

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super()
      // Only reflect the stored choice here: storing on load would write 'auto' for visitors
      // who never touched the picker.
      StarlightThemeProvider.updatePickers(loadTheme())
      this.querySelector('select')?.addEventListener('change', (e) => {
        if (e.currentTarget instanceof HTMLSelectElement) onThemeChange(parseTheme(e.currentTarget.value))
      })
    }
  }
  customElements.define('starlight-theme-select', StarlightThemeSelect)
</script>

<style>
  @layer starlight.core {
    label {
      --sl-label-icon-size: 0.875rem;
      --sl-caret-size: 1.25rem;
      --sl-inline-padding: 0.5rem;
      --sl-select-width: 6.25em;
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      color: var(--sl-color-gray-2);
    }
    label:hover {
      color: var(--sl-color-white);
    }
    .icon {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
    }
    select {
      border: 0;
      padding-block: 0.625rem;
      padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
        calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
      margin-inline: calc(var(--sl-inline-padding) * -1);
      width: calc(var(--sl-select-width) + var(--sl-inline-padding) * 2);
      background-color: transparent;
      text-overflow: ellipsis;
      color: inherit;
      cursor: pointer;
      appearance: none;
    }
    option {
      background-color: var(--sl-color-bg-nav);
      color: var(--sl-color-gray-1);
    }
    @media (min-width: 50rem) {
      select {
        font-size: var(--sl-text-sm);
      }
    }
  }
  @layer starlight.components {
    .label-icon {
      font-size: var(--sl-label-icon-size);
      inset-inline-start: 0;
    }
    .caret {
      font-size: var(--sl-caret-size);
      inset-inline-end: 0;
    }
  }
</style>
