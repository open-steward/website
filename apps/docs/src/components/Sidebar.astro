---
// Starlight's Sidebar without SidebarPersister, whose inline scripts restore the open groups
// and scroll position between pages. The Content-Security-Policy allows no inline script, so
// the sidebar starts from the current page each time instead.
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter'
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro'

const { sidebar } = Astro.locals.starlightRoute
---

<SidebarSublist sublist={sidebar} />

<div class="md:sl-hidden"><MobileMenuFooter /></div>
