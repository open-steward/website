---
// A Phosphor icon (the design system's icon set), inlined as SVG at build time: no icon font,
// no CDN, nothing for the Content-Security-Policy to allow.
import { readFileSync } from 'node:fs'
import { createRequire } from 'node:module'

interface Props {
  name: string
  class?: string
}

const { name, class: className = 'icon' } = Astro.props
if (!/^[a-z0-9-]+$/.test(name)) throw new Error(`bad icon name: ${name}`)
const require = createRequire(import.meta.url)
const file = require.resolve(`@phosphor-icons/core/assets/regular/${name}.svg`)
const svg = readFileSync(file, 'utf8').replace(
  '<svg ',
  `<svg class="${className}" aria-hidden="true" focusable="false" width="1em" height="1em" `,
)
---

<Fragment set:html={svg} />
